{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neosync:manifest:1",
  "title": "NeoSync client manifest version 1",
  "description": "Structural contract only. Apply the semantic and security checks in protocol-v1.md before using a manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "serverId", "revision", "displayName", "minecraftVersion", "loader", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "serverId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1, "maxLength": 64},
    "displayName": {"$ref": "#/$defs/displayName"},
    "minecraftVersion": {"const": "1.21.1"},
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "neoForgeVersion"],
      "properties": {
        "id": {"const": "neosync"},
        "version": {"$ref": "#/$defs/version"},
        "neoForgeVersion": {"$ref": "#/$defs/version"}
      }
    },
    "files": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "modId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$", "minLength": 2, "maxLength": 64},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size", "fileName", "required", "mods", "sources"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "fileName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*\\.jar$", "minLength": 5, "maxLength": 128},
        "required": {"const": true},
        "mods": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/mod"}},
        "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "dependencies"],
      "properties": {
        "id": {"$ref": "#/$defs/modId"},
        "version": {"$ref": "#/$defs/version"},
        "displayName": {"$ref": "#/$defs/displayName"},
        "dependencies": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/dependency"}}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionRange", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/modId"},
        "versionRange": {"type": "string", "minLength": 1, "maxLength": 128},
        "type": {"enum": ["required", "optional", "incompatible", "discouraged"]}
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": {"const": "external"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
            "provider": {"$ref": "#/$defs/provider"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "server"}}
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "fileId"],
      "properties": {
        "id": {"enum": ["modrinth", "curseforge"]},
        "projectId": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 128},
        "fileId": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 128}
      }
    }
  }
}

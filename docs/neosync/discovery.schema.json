{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neosync:discovery:1",
  "title": "NeoSync status capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocols"
  ],
  "properties": {
    "protocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "httpsPort": {
      "type": "integer",
      "enum": [
        443,
        8443
      ]
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "httpPort": {
      "type": "integer",
      "enum": [
        80,
        8080
      ]
    },
    "unavailable": {
      "const": true
    }
  },
  "oneOf": [
    {
      "required": [
        "httpsPort",
        "manifestSha256"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "httpPort"
            ]
          },
          {
            "required": [
              "unavailable"
            ]
          }
        ]
      },
      "properties": {
        "protocols": {
          "contains": {
            "const": 1
          }
        }
      }
    },
    {
      "required": [
        "httpPort",
        "manifestSha256"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "httpsPort"
            ]
          },
          {
            "required": [
              "unavailable"
            ]
          }
        ]
      },
      "properties": {
        "protocols": {
          "const": [
            2
          ]
        }
      }
    },
    {
      "required": [
        "unavailable"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "manifestSha256"
            ]
          },
          {
            "required": [
              "httpPort"
            ]
          },
          {
            "required": [
              "httpsPort"
            ]
          }
        ]
      }
    }
  ]
}
